# gateway/.env に追記するカスタム設定の例（上流の gateway/.env.example もあわせて参照）
# <...> は自分の値に置き換えてください。秘密情報は絶対にコミットしないこと。

# --- 必須/接続 ---
GEMINI_API_KEY=<YOUR_GEMINI_API_KEY>
STACKCHAN_TOKEN=<YOUR_SHARED_TOKEN>
VISION_HOST=<GATEWAY_LAN_IP>
STACKCHAN_GEMINI_VOICE=Kore

# --- 顔追従: カメラは起動するが頭は動かさない（呼んだ時だけ動く） ---
STACKCHAN_FACE_TRACKER_AUTOSTART=1
STACKCHAN_HEAD_FOLLOW_DEFAULT=0

# --- Grok Bot 音声バックエンド ---
STACKCHAN_VOICE_BACKEND=gbot
STACKCHAN_GBOT_VOICE_BOT_ID=<YOUR_VOICE_BOT_ID>
STACKCHAN_TOOL_BOT=<YOUR_TASK_AGENT_NAME>
STACKCHAN_TOOL_BOT_ID=<YOUR_TASK_AGENT_ID>
STACKCHAN_GBOT_VOICE_LANGUAGE=ja
STACKCHAN_GBOT_LOG_USER_TRANSCRIPT=1
STACKCHAN_ASK_CLAUDE=0
# <TASK_AGENT_NAME> / <YOUR_CITY> / ○○店・△△・○○さん は自分の環境に合わせて書き換え
STACKCHAN_GBOT_VOICE_EXTRA_INSTRUCTIONS=返答は必ず日本語で、短く自然に。ユーザーが何かをしてほしいと頼んだとき（調べて、予定、メール、作って、確認して、まとめて など）は、自分で答えずに必ず send_task を使い、ユーザーの依頼をそのまま日本語で request に入れて「<TASK_AGENT_NAME>」に渡す。relay=accepted なら「<TASK_AGENT_NAME>に頼んだよ。結果が来たら伝えるね」と日本語で伝える。結果が届いたら日本語で短く読み上げる。 ユーザーが「寝て」「眠って」「おやすみ」「もういいよ」などと言ったら、send_task は使わずに「おやすみ。用があったら、すたちゃんって呼んでね」とだけ言ってから end_the_call を呼ぶ。眠っている間は呼び名で起こされるまで反応しない。呼び名のあとに「起きて」と言われたら「おはよう、どうしたの？」と元気に返す。 ユーザーが「おはよう」と言ったとき、または朝の声かけに「うん」「お願い」と答えたときは、send_task で「今日の予定（Googleカレンダー）、昨日から届いた大事なメール（Gmail、広告は除く）、<YOUR_CITY>の今日の天気を、声で読み上げやすいように短くまとめて」と依頼し、結果が届いたら読み上げる。お店の売上を聞かれたら send_task で「サロンボードで○○店の△△の売上を調べて」と依頼する。スタッフへの連絡を頼まれたら send_task で「Chatworkで○○さん宛ての下書きを作って、送る前に確認させて」と依頼し、勝手に送らせない。

# --- ウェイクワード「すたちゃん」（+ Hi Grok 予備）。"|" 区切りは gateway.patch が必要 ---
STACKCHAN_WAKE_PHRASE=すたちゃん
STACKCHAN_WAKE_KEYWORD=S UW1 T AA1 CH AA1 N @sutachan_su|S UH1 T AA1 CH AA1 N @sutachan_suh|S UW1 T AH1 CH AA1 N @sutachan_sua|S T AA1 CH AE1 N @sutachan_tae|S T AA1 R CH AA1 N @sutachan|S T AA1 R CH AH1 N @sutachan_ah|S T AA1 R CH AE1 N @sutachan_ae|S T AH1 CH AE1 N @sutachan_sta|S T AH1 CH AA1 N @sutachan_stuh|S T AA1 CH AA1 N @sutachan_staa|HH AY1 G R AA1 K @hi_grok|HH AY1 G R OW1 K @hi_grok_ow|HH AY1 G R AO1 K @hi_grok_ao|HH AY1 G R AH1 K @hi_grok_ah
STACKCHAN_KWS_THRESHOLD=0.015
STACKCHAN_KWS_SCORE=14

# --- Mac に挿した USB マイクを使う（gateway.patch が必要、ffmpeg 必須）。デバイス名の一部 ---
STACKCHAN_EXTERNAL_MIC=<USB_MIC_NAME e.g. HyperX SoloCast 2>
