+    async def _run_external_mic(self) -> None:
+        """Local patch: stream a Mac mic (ffmpeg avfoundation) as 16 kHz PCM."""
+        device = os.getenv("STACKCHAN_EXTERNAL_MIC", "").strip()
+        ffmpeg = os.getenv("STACKCHAN_FFMPEG", "/opt/homebrew/bin/ffmpeg")
+        gain = os.getenv("STACKCHAN_EXTERNAL_MIC_GAIN", "1.0")
+        chunk = 1920  # 60 ms at 16 kHz mono s16le
+        while not self._stopped:
+            proc = None
+            try:
+                proc = await asyncio.create_subprocess_exec(
+                    ffmpeg, "-hide_banner", "-loglevel", "error",
+                    "-f", "avfoundation", "-i", f":{device}",
+                    "-af", f"volume={gain}", "-ac", "1", "-ar", "16000",
+                    "-f", "s16le", "-",
+                    stdout=asyncio.subprocess.PIPE,
+                    stderr=asyncio.subprocess.PIPE,
+                )
+                logger.info("external mic started device=%r", device)
+                assert proc.stdout is not None
+                while not self._stopped:
+                    pcm = await proc.stdout.readexactly(chunk)
+                    if self._accepts_device_audio():
+                        await self._forward_gated_device_pcm(pcm)
+            except asyncio.CancelledError:
+                raise
+            except Exception as exc:
+                err = b""
+                if proc is not None and proc.stderr is not None:
+                    try:
+                        err = await asyncio.wait_for(proc.stderr.read(400), 1)
+                    except Exception:
+                        pass
+                logger.warning("external mic failed: %s %s", exc, err.decode(errors="ignore"))
+                await asyncio.sleep(3)
+            finally:
+                if proc is not None and proc.returncode is None:
+                    proc.kill()
